{
  "name": "agentyc-browser-automation",
  "version": "2.0.0",
  "description": "Deterministic browser task-space automation for coding agents via direct CLI and Node SDK; MCP is compatibility-only.",
  "license": "MIT",
  "primary_interface": {
    "type": "direct",
    "cli": "agentyc",
    "sdk": "@agentyc/browser",
    "object_model": ["space", "page"]
  },
  "mcp": {
    "name": "agentyc",
    "transport": "stdio",
    "command": "agentyc",
    "args": ["mcp"]
  },
  "skills": [".agents/skills/agentyc-browser-automation/SKILL.md"],
  "install": {
    "binary": "cargo install --git https://github.com/distillation-labs/agentyc agentyc",
    "verify": "agentyc --version"
  },
  "docs": {
    "skill": ".agents/skills/agentyc-browser-automation/SKILL.md",
    "tool_playbook": ".agents/skills/agentyc-browser-automation/references/tool-playbook.md",
    "evals": ".agents/skills/agentyc-browser-automation/evals/cases.yaml"
  }
}
