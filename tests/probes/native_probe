#!/bin/sh
# Chrome launches Native Messaging hosts without a shell profile. Resolve a
# real Python interpreter without relying on the GUI process PATH.
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for interpreter in \
  /opt/homebrew/bin/python3 \
  /usr/local/bin/python3 \
  /usr/bin/python3
 do
  if [ -x "$interpreter" ]; then
    exec "$interpreter" "$SCRIPT_DIR/native_probe.py" "$@"
  fi
done

interpreter=$(command -v python3 2>/dev/null || true)
if [ -n "$interpreter" ] && [ -x "$interpreter" ]; then
  exec "$interpreter" "$SCRIPT_DIR/native_probe.py" "$@"
fi

printf '%s\n' 'native probe could not locate a supported Python 3 interpreter' >&2
exit 127
