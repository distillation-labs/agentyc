# agentyc runtime configuration
# Every variable below is read by the Rust binary. All are optional.

# ── Logging ────────────────────────────────────────────────────────────────
# tracing EnvFilter directive (e.g. warn, info, debug)
AGENTYC_LOGGING_LEVEL=info

# ── Browser behavior ─────────────────────────────────────────────────────────
# Run Chrome headless ("1" to enable). Default: visible.
# AGENTYC_HEADLESS=1
# Comma-separated domain allowlist; navigation outside it is blocked.
# AGENTYC_ALLOWED_DOMAINS=example.com,*.example.org

# ── Timeouts ──────────────────────────────────────────────────────────────────
# Per-action CDP timeout in seconds (default 180).
# AGENTYC_ACTION_TIMEOUT_S=180
# CDP response timeout in seconds (default 60).
# AGENTYC_CDP_TIMEOUT_S=60

# ── Proxy ─────────────────────────────────────────────────────────────────────
# AGENTYC_PROXY_URL=http://proxy.example.com:8080
# AGENTYC_PROXY_BYPASS=localhost,127.0.0.1,*.internal
# AGENTYC_PROXY_USERNAME=username
# AGENTYC_PROXY_PASSWORD=password

# ── Chrome discovery ──────────────────────────────────────────────────────────
# Override where agentyc looks for a Chromium binary (e.g. a cached install).
# PLAYWRIGHT_BROWSERS_PATH=/path/to/chromium/cache
