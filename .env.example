# agentyc runtime configuration

# Logging
AGENTYC_LOGGING_LEVEL=info
CDP_LOGGING_LEVEL=WARNING
# AGENTYC_DEBUG_LOG_FILE=debug.log
# AGENTYC_INFO_LOG_FILE=info.log

# Telemetry and version checks
ANONYMIZED_TELEMETRY=true
AGENTYC_VERSION_CHECK=true

# Action timeout used by agentyc.tools.service
AGENTYC_ACTION_TIMEOUT_S=180

# Browser behavior
# AGENTYC_HEADLESS=false
# AGENTYC_ALLOWED_DOMAINS=example.com,*.example.org
# AGENTYC_DISABLE_EXTENSIONS=false

# Config path overrides
# AGENTYC_CONFIG_PATH=~/.config/agentyc/config.json
# AGENTYC_CONFIG_DIR=~/.config/agentyc

# Proxy configuration
# AGENTYC_PROXY_URL=http://proxy.example.com:8080
# AGENTYC_NO_PROXY=localhost,127.0.0.1,*.internal
# AGENTYC_PROXY_USERNAME=username
# AGENTYC_PROXY_PASSWORD=password

# Optional shared-config LLM defaults
# AGENTYC_LLM_MODEL=gpt-4.1-mini

# Optional LLM provider credentials
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Optional hosted agentyc LLM provider credential
# This is not required for the default MCP browser runtime.
# AGENTYC_API_KEY=
