{
  "manifest_version": 3,
  "name": "Agentyc",
  "version": "0.1.0",
  "description": "Host-authorized logical task spaces for an existing Chrome profile.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "125",
  "incognito": "not_allowed",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "src/tab-creation-worker.mjs",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
