{
  "manifest_version": 3,
  "name": "agentyc Existing Chrome",
  "version": "0.1.0",
  "description": "Host-authorized logical task spaces for an existing Chrome profile.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage",
    "tabs",
    "tabGroups",
    "sidePanel"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "src/service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Open agentyc task spaces"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
